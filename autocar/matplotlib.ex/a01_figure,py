import matplotlib.pyplot as plt
import numpy as np

def main():
    data1 = np.random.rand(10)
    data2 = np.random.random(30).reshape(3, 10)
    fig = plt.figure(figsize=(8, 6))
    ax1 = fig.add_subplot(2, 1, 1)
    ax2 = fig.add_subplot(2, 1, 2)
    ax1.plot(data1)
    ax2.plot(data2)
    print("hi")
if __name__ == "__main__":
    main()